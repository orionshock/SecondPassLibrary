# Copy to `.env` and adjust values before running Docker Compose.

# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret
DJANGO_TIME_ZONE=America/Phoenix
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-hostname-or-domain
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_USE_X_FORWARDED_HOST=0
SECOND_PASS_ENABLE_DJANGO_ADMIN=0
# Not enabled by default for Docker. Use only when intentionally silencing
# specific Django deploy warnings for a known deployment shape.
DJANGO_SILENCED_SYSTEM_CHECKS=

# Runtime data directory inside the container.
SECOND_PASS_USERDATA_DIR=/app/userdata
