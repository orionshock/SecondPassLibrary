# Optional environment variables for local development.
# Copy to `.env` and adjust values as needed.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_TIME_ZONE=America/Phoenix
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_SECURE_COOKIES=0

# Runtime data directory (defaults to `./userdata`)
SECOND_PASS_USERDATA_DIR=userdata
