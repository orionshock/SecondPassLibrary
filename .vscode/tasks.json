{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Develop: Full Stack",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\start-dev.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Verify: Fast",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/verify.py", "--lane", "fast"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Verify: Backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/verify.py", "--lane", "backend"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Verify: Frontend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/verify.py", "--lane", "frontend"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Security: Dependency Advisories",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/verify.py", "--lane", "security-deps"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Verify: All",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "tools/verify.py",
        "--lane",
        "all"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
