{
  "folders": [
    {
      "path": ".",
      "name": "SecondPassLibrary"
    }
  ],
  "settings": {
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
      "**/.agents": true,
      "**/.coverage*": true,
      "**/.env": true,
      "**/.git": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/.venv": true,
      "**/__pycache__": true,
      "**/*.egg-info": true,
      "**/*.py[cod]": true,
      "**/*.tsbuildinfo": true,
      "**/build": true,
      "**/coverage": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/out": true,
      "**/var": true,
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
      "${workspaceFolder}/backend"
    ],
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests"
    ],
    "python.testing.unittestEnabled": false,
    "vitest.rootConfig": "frontend/vite.config.ts",
    "ruff.nativeServer": "on",
    "chat.tools.terminal.autoApprove": {
      "${workspaceFolder}/.venv/bin/python": true,
      "docker compose": true,
      "mkdir": true,
      "mv": true,
      "true": true
    },
    "LineCount.includes": [
      "backend/**/*",
      "frontend/index.html",
      "frontend/src/**/*",
      "frontend/packages/spl-api/src/**/*"
    ],
    "LineCount.excludes": [
      "**/__pycache__/**",
      "**/__tests__/**",
      "**/migrations/**",
      "backend/web/product_ui/**",
      "backend/var/**",
      "**/*.png"
    ],
    "LineCount.showStatusBarItem": true,
    "LineCount.output": {
      "txt": true,
      "json": false,
      "csv": false,
      "md": false,
      "outdir": ".linecount"
    },
    "LineCount.sort": "filename",
    "LineCount.order": "asc",
    "sqltools.connections": [
      {
        "previewLimit": 50,
        "driver": "SQLite",
        "database": "${workspaceFolder:SecondPassLibrary}/userdata/db/db.sqlite3",
        "name": "SPL userdata db"
      }
    ],
    "sqltools.useNodeRuntime": true
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy",
      "ms-python.vscode-python-envs",
      "charliermarsh.ruff",
      "vitest.explorer",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "yycalm.linecount"
    ]
  }
}
