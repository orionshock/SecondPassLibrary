{
  "folders": [
    {
      "path": ".",
      "name": "SecondPassLibrary"
    }
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": [
      "${workspaceFolder}/backend"
    ],
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests"
    ],
    "python.testing.unittestEnabled": false,
    "vitest.rootConfig": "frontend/vite.config.ts",
    "ruff.nativeServer": "on",
    "chat.tools.terminal.autoApprove": {
      "${workspaceFolder}/.venv/bin/python": true,
      "docker compose": true,
      "mkdir": true,
      "mv": true,
      "true": true
    },
    "LineCount.excludes": [
      "*.md",
      "*.png",
      "**/__init__.py",
      "**/__pycache__/**",
      "**/__tests__/**",
      "**/.pytest_cache/**",
      "**/TestFiles/**",
      "**/.ruff_cache/**",
      "**/.venv/**",
      "**/.vscode/**",
      "**/coverage/**",
      "**/dist/**",
      "**/migrations/*.py",
      "**/node_modules/**",
      "**/out/**",
      "**/package-lock.json",
      "**/test/**",
      "**/tests/**",
      "**/*.tsbuildinfo",
      "**/userdata/**",
      "**/var/**",
      ".coverage",
      "**/.env.example",
      ".gitattributes",
      ".git",
      ".gitignore",
      "SecondPassLibrary.code-workspace",
      "**/docs/**",
      "pyrightconfig.json",
      "requirements.txt",
      "**/tools/**",
      "backend/web/static/web/favicon.png"
    ],
    "sqltools.connections": [
      {
        "previewLimit": 50,
        "driver": "SQLite",
        "database": "${workspaceFolder:SecondPassLibrary}/userdata/db/db.sqlite3",
        "name": "SPL userdata db"
      }
    ],
    "sqltools.useNodeRuntime": true
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy",
      "ms-python.vscode-python-envs",
      "charliermarsh.ruff",
      "vitest.explorer",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml"
    ]
  }
}
