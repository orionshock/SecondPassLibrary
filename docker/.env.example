# Copy to `.env` in this directory and adjust values before running Docker Compose.

# Required production values.
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret
# Name the Second Pass Library server as users address it in their URLs, not the
# connecting client devices. Wildcards, URL forms, and this placeholder fail the
# production deploy check.
DJANGO_ALLOWED_HOSTS=your-hostname-or-domain

# Optional Django/runtime values.
DJANGO_DEBUG=0
DJANGO_TIME_ZONE=America/Phoenix
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=0
# HTTPS proxy deployments must set this to 1; deploy checks reject trusted
# forwarded HTTPS with insecure cookies.
# Uvicorn does not interpret proxy headers. Django owns these trust decisions.
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_TRUST_X_FORWARDED_FOR=0
# Exact direct-peer addresses and bounded CIDR networks are supported. Trust-all
# networks are rejected when forwarded client-IP trust is enabled.
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_USE_X_FORWARDED_HOST=0
SECOND_PASS_ENABLE_DJANGO_ADMIN=0
SECOND_PASS_READER_WEB_CLIENT_URL=

# Use only to silence specific deploy warnings for a known deployment shape.
DJANGO_SILENCED_SYSTEM_CHECKS=
