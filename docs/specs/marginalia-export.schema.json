{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondpasslibrary.local/specs/marginalia/0.1.0/export-schema.json",
  "title": "Second Pass Library Marginalia Export Archive",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "profile",
    "generated_at",
    "generator",
    "scope",
    "books"
  ],
  "properties": {
    "type": { "const": "SecondPassMarginaliaExport" },
    "schema_version": { "const": "0.1.0" },
    "profile": {
      "const": "https://secondpasslibrary.local/specs/marginalia/0.1.0"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "books": {
      "type": "array",
      "items": { "$ref": "#/$defs/book" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "all" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "books"],
          "properties": {
            "type": { "const": "selected" },
            "books": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["book", "session_filter"],
                "properties": {
                  "book": { "type": "string", "minLength": 1 },
                  "session_filter": { "enum": ["all", "selected"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "book"],
          "properties": {
            "type": { "const": "book" },
            "book": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "book", "session"],
          "properties": {
            "type": { "const": "session" },
            "book": { "type": "string", "minLength": 1 },
            "session": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "book": {
      "type": "object",
      "required": ["source", "file_hash", "title", "authors", "sessions"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "file_hash": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "series": { "type": "string" },
        "series_index": { "type": ["string", "null"] },
        "language": { "type": "string" },
        "isbn": { "type": "string" },
        "epub_unique_identifier": { "type": "string" },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "https://secondpasslibrary.local/specs/marginalia/0.1.0/schema.json#/$defs/readingSession"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
