{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondpasslibrary.local/specs/marginalia-export.schema.json",
  "title": "Second Pass Library Marginalia Export",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "profile",
    "generated_at",
    "generator",
    "scope",
    "books"
  ],
  "properties": {
    "type": { "const": "SecondPassMarginaliaExport" },
    "schema_version": { "const": "0.1.0" },
    "profile": { "type": "string" },
    "generated_at": { "type": "string" },
    "generator": { "type": "string" },
    "scope": { "$ref": "#/$defs/scope" },
    "books": {
      "type": "array",
      "items": { "$ref": "#/$defs/book" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "book", "session"],
          "properties": {
            "type": { "const": "session" },
            "book": { "type": "string" },
            "session": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "book"],
          "properties": {
            "type": { "const": "book" },
            "book": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "book", "session_filter"],
          "properties": {
            "type": { "const": "book" },
            "book": { "type": "string" },
            "session_filter": { "const": "selected" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "all" }
          },
          "additionalProperties": false
        }
      ]
    },
    "book": {
      "type": "object",
      "required": ["title", "authors", "source", "file_hash", "sessions"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "series": { "type": "string" },
        "series_index": { "type": ["string", "null"] },
        "language": { "type": "string" },
        "isbn": { "type": "string" },
        "epub_unique_identifier": { "type": "string" },
        "source": { "type": "string" },
        "file_hash": { "type": "string" },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session" }
        }
      },
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "required": [
        "export_session_id",
        "name",
        "status",
        "started_at",
        "completed_at",
        "created_at",
        "updated_at",
        "notes",
        "progress",
        "annotations"
      ],
      "properties": {
        "export_session_id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "enum": ["active", "completed", "archived"] },
        "started_at": { "type": "string" },
        "completed_at": { "type": ["string", "null"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "notes": { "type": "string" },
        "progress": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/progress" }
          ]
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["current_location", "progression", "profile_version", "updated_at"],
      "properties": {
        "current_location": { "type": ["object", "null"] },
        "progression": { "type": ["number", "null"] },
        "profile_version": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["motivation", "target", "body", "is_deleted", "created_at", "updated_at"],
      "properties": {
        "motivation": {
          "type": "array",
          "items": { "enum": ["bookmarking", "highlighting", "commenting"] }
        },
        "target": {
          "type": "object",
          "required": ["selector"],
          "properties": {
            "selector": { "$ref": "#/$defs/selector" }
          },
          "additionalProperties": false
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/textualBody" }
        },
        "is_deleted": { "type": "boolean" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        { "$ref": "#/$defs/fragmentSelector" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/fragmentSelector" },
            { "$ref": "#/$defs/textQuoteSelector" }
          ],
          "items": false
        }
      ]
    },
    "fragmentSelector": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "FragmentSelector" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "textQuoteSelector": {
      "type": "object",
      "required": ["type", "exact"],
      "properties": {
        "type": { "const": "TextQuoteSelector" },
        "exact": { "type": "string" },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "textualBody": {
      "type": "object",
      "required": ["type", "purpose", "value"],
      "properties": {
        "type": { "const": "TextualBody" },
        "purpose": { "enum": ["describing", "commenting"] },
        "value": { "type": "string" },
        "color": { "enum": ["yellow", "green", "blue", "pink", "purple", "orange"] }
      },
      "additionalProperties": false
    }
  }
}
